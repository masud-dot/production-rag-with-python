# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Required for generation and API embeddings (Chapters 1, 7, 9).
OPENAI_API_KEY=

# Capability tiers, not model identifiers in prose (Appendix A, Tier 2).
GENERATION_MODEL=
EMBEDDING_MODEL=

# Optional: served vector index (Chapter 8). Omit to use the local index.
QDRANT_URL=
QDRANT_API_KEY=

# Lighthouse settings (Chapter 10). Defaults are the measured values.
LIGHTHOUSE_CORPUS_ROOT=data/corpus.json
LIGHTHOUSE_INDEX_PATH=var/index
LIGHTHOUSE_RETRIEVAL_MODE=hybrid
LIGHTHOUSE_RETRIEVAL_TOP_K=5
LIGHTHOUSE_RETRIEVAL_DEPTH=50
